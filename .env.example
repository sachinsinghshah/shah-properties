# SMTP Configuration (required for contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Contact email destination (defaults to SMTP_USER if not set)
CONTACT_EMAIL_TO=your-email@gmail.com
CONTACT_EMAIL_FROM=your-email@gmail.com

# Site base URL (used for canonical URLs and structured data)
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Search engine verification codes (optional)
YANDEX_VERIFICATION_CODE=
YAHOO_VERIFICATION_CODE=
